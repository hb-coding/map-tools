    "format-espretty": "prettier-eslint \"src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "maplibre-gl": "^5.20.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@rspack/cli": "^1.3.0",
    "@rspack/core": "^1.3.0",
    "@rspack/plugin-react-refresh": "^1.3.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "prettier-eslint-cli": "^8.0.1",
    "react-refresh": "^0.17.0"
