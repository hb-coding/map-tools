{
  "name": "map-tools",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "description": "Repository related to map tools and map tool exploration",
  "scripts": {
    "dev": "rspack dev",
    "build": "rspack build",
    "preview": "rspack preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
